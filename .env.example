# Sao chép file này thành .env rồi điền URI MongoDB Atlas thật.
# Nếu mật khẩu có ký tự đặc biệt (@, :, /, #, %, ...), hãy URL-encode mật khẩu.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/HeThongKiemDinh?retryWrites=true&w=majority

# true: tự bổ sung/khôi phục dữ liệu demo khi dữ liệu nghiệp vụ thiếu.
# false: không tự seed demo.
APP_SEED_DEMO_DATA=false
